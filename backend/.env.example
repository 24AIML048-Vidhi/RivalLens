# --- Database ---
# Local dev default (sqlite) works out of the box with no setup.
# Swap to Postgres when ready, e.g:
# DATABASE_URL=postgresql://user:password@localhost:5432/rivallens
DATABASE_URL=sqlite:///./rivallens.db

# --- Instagram API (Meta for Developers / Instagram Graph API) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=

# --- YouTube Data API v3 (Google Cloud Console) ---
YOUTUBE_API_KEY=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173